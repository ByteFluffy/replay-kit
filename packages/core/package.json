{
  "name": "@replay-kit/core",
  "version": "0.1.0",
  "description": "Zero-dependency replay engine: protocol, time warp, controller, recorder.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteFluffy/replay-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ByteFluffy/replay-kit#readme",
  "bugs": {
    "url": "https://github.com/ByteFluffy/replay-kit/issues"
  },
  "keywords": [
    "replay",
    "session-replay",
    "agent",
    "crdt",
    "time-warp",
    "jsonl"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\""
  }
}
